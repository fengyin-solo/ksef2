{
  "include": ["src", "tests"],
  // tests/compat is typechecked against an installed wheel by the legacy
  // compatibility gate (tests/compat/pyrightconfig.json), not against src/.
  "exclude": [".venv", "src/ksef2/_infra/schema/api/spec", "src/ksef2/_infra/schema/fa3/models", "tests/compat"],
  "venvPath": ".",
  "venv": ".venv",
  "reportImplicitStringConcatenation": false,
  "reportUnannotatedClassAttribute": false
}
